{
  "name": "oishie",
  "version": "0.1.0",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "dev": "next dev -p 3000",
    "serve:lan": "node scripts/lan-serve.mjs",
    "build": "next build",
    "start": "next start -p 3000",
    "build:rel": "set NEXT_DIST_DIR=.next-rel&& next build",
    "pack:rel": "set NEXT_DIST_DIR=.next-rel&& node scripts/pack-standalone.mjs",
    "dist:win": "npm run build:rel && npm run pack:rel && electron-builder --win nsis"
  },
  "build": {
    "appId": "com.oishie.app",
    "productName": "OiShi-e!",
    "asar": false,
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**",
      "standalone-dist/**",
      "certs/lan/**/*",
      "build/icon.ico",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico"
    }
  },
  "dependencies": {
    "@capacitor-community/speech-recognition": "^7.0.1",
    "@capacitor/android": "^8.6.0",
    "@capacitor/core": "^8.6.0",
    "@mediapipe/tasks-vision": "^1.2.0",
    "@ricky0123/vad-web": "0.0.31",
    "@types/three": "^0.170.0",
    "1eurofilter": "^1.3.0",
    "motion": "11.18.2",
    "next": "14.2.35",
    "onnxruntime-web": "1.17.3",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.0",
    "@types/node": "20.14.0",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "lamejs": "^1.2.1",
    "typescript": "5.4.5"
  },
  "overrides": {
    "postcss": "^8.5.32"
  }
}
