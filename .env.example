# Meta Model API — dev.meta.ai / Discord #resources 에서 발급
# PowerShell: $env:MODEL_API_KEY="여기에_키"
# Bash: export MODEL_API_KEY="여기에_키"
# .env 파일을 만들면 테스트 스크립트가 자동 로드함 (절대 커밋 금지)
# 없으면 AI 라우트 8개가 오프라인 대체 결과(fallback:true)로 동작한다.
MODEL_API_KEY=

# Snap Quest 기본 모델 ID
MUSE_MODEL_WONDER=muse-wonder-1.0
MUSE_MODEL_SPARK=muse-spark-1.3
MUSE_MODEL_IMAGE=muse-image-1.0
MUSE_MODEL_VOICE=muse-voice-transcribe-1.0
MUSE_MODEL_SAM=sam-3.1

# Google OIDC 소셜 로그인 (Google Cloud Console → OAuth 클라이언트 발급)
# 승인된 리디렉션 URI에 GOOGLE_REDIRECT_URI 값을 등록해야 함
# 없으면 /login?error=oauth_unconfigured 로 돌아가고 게스트 플레이.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/callback/google

# YouTube Data API v3 (VA-1 "유튜브 힙한 곳", Google Cloud Console에서 발급, 선택)
# 없으면 data/places/hip.json 큐레이션 목록으로 동작한다.
YOUTUBE_API_KEY=

# Meta OIDC 소셜 로그인 (플레이스홀더: 미연동 — /api/auth/meta 연동 시 발급, 값은 직접 입력)
#META_CLIENT_ID=
#META_CLIENT_SECRET=
#META_REDIRECT_URI=http://localhost:3000/api/auth/callback/meta

# 세션 서명 전용 시크릿 (권장, 미설정 시 GOOGLE_CLIENT_SECRET으로 대체)
SESSION_SECRET=

# LAN 데모 페어링 코드 (SEC-5). serve:lan 실행 시 자동 생성되므로 평소엔 비워 둔다.
#PAIRING_CODE=
